# Секреты только здесь и в окружении. Значения в репозиторий не коммитим.

# --- База ---------------------------------------------------------------
# Локально — файл SQLite. На Vercel файловой системы нет, поэтому там
# libsql://<имя>-<организация>.turso.io и токен: тот же SQLite по сети.
DATABASE_URL=file:mangal.db
DATABASE_AUTH_TOKEN=

# Логин/пароль первого администратора — используются только скриптом сида.
# По удалённой базе сид дополнительно требует SEED_CONFIRM=yes: он удаляет товары.
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=

# --- Сессии админки -----------------------------------------------------
# Ключ подписи. Минимум 32 символа. Сгенерировать: openssl rand -base64 32
AUTH_SECRET=

# --- Хранилище спрайтов -------------------------------------------------
# Пусто — спрайты пишутся в public/sprites/uploads/ (локальная разработка).
# Задан — уходят в Vercel Blob. На Vercel переменная появляется сама,
# когда к проекту подключён Blob Store.
BLOB_READ_WRITE_TOKEN=

# --- Адреса -------------------------------------------------------------
# Публичный адрес сайта: письма, OG, ссылки на заказ
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Подкаталог для статического демо на GitHub Pages. На Vercel не нужен.
NEXT_PUBLIC_BASE_PATH=

# --- Уведомления --------------------------------------------------------
# Если пусто — заказ всё равно сохраняется, отправка пропускается.
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_EMAIL_MANAGER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Режим витрины ------------------------------------------------------
# Плашка «оплата не производится»
NEXT_PUBLIC_DEMO_MODE=true

# Секреты только здесь и в окружении. Значения в репозиторий не коммитим.

# Файл SQLite. На Turso заменяется на libsql://... + TURSO_AUTH_TOKEN
DATABASE_URL=file:mangal.db

# Ключ подписи сессии админки. Минимум 32 символа.
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=

# Логин/пароль первого администратора — используются только скриптом сида
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=

# Публичный адрес сайта: письма, OG, ссылки на заказ
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Уведомления. Если пусто — заказ всё равно сохраняется, отправка пропускается.
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_EMAIL_MANAGER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Витрина-демо: показывать плашку «оплата не производится»
NEXT_PUBLIC_DEMO_MODE=true
